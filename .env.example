# --- Environment mode -------------------------------------------------
# "local"  -> uses .env + Gemini API key + Streamlit session state only.
#             No GCP credentials required.
# "gcp"    -> uses Application Default Credentials (ADC), Vertex AI,
#             BigQuery, Secret Manager, and Cloud Logging.
ENVIRONMENT=local

# --- Gemini (required in local mode) -----------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- GCP (required only when ENVIRONMENT=gcp) ---------------------------
# No service-account JSON is used -- authenticate via:
#   gcloud auth application-default login
GCP_PROJECT_ID=your-gcp-project-id
USE_VERTEX_AI=false
BIGQUERY_DATASET=careval_ai
BIGQUERY_TABLE=day_logs

# --- MoSPI time-use (optional live JSON; minutes only, never wages) ------
# If unset or unreachable, CareVal uses src/data/mospi_benchmarks.json.
# MOSPI_BENCHMARKS_URL=https://example.com/mospi_tus_minutes.json
MOSPI_CATALOG_URL=https://microdata.gov.in/nada/index.php/catalog/223

# --- Logging -------------------------------------------------------------
LOG_LEVEL=INFO
